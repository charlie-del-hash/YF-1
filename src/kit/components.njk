<div class="grid grid--3">
  <article class="card">
    <div class="frame"><span class="frame-label">Image · 16:9</span></div>
    <span class="kicker">Kicker</span>
    <h3 class="card-hed"><a href="#">Card with image, kicker, headline, dek and meta</a></h3>
    <p class="card-dek">Cards render automatically on section archives and the front page.</p>
    <p class="card-meta">Section · Date</p>
  </article>
  <article class="card">
    <span class="kicker">Kicker</span>
    <h3 class="card-hed"><a href="#">Text-only card for compact listings</a></h3>
    <p class="card-meta">Section · Date</p>
  </article>
  <article class="card">
    <span class="dateline">Dateline — 18 Jul</span>
    <h3 class="card-hed"><a href="#">Wire-style card using a dateline instead of a kicker</a></h3>
    <p class="card-meta">Briefs</p>
  </article>
</div>

