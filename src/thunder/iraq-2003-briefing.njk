---
title: "SLIDES 2003 · The War on Bullet Points — Theme Thunder"
---
{%- set art = collections.articles | articleBySlug("iraq-2003-briefing") -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — {{ site.name }}</title>
<meta name="description" content="{{ art.data.dek }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ art.data.title }} — Theme Thunder edition">
<meta property="og:description" content="Theme Thunder: the Iraq 2003 slide-deck war, presented as a period Office slide deck — Luna-blue chrome, UNCLASSIFIED bars, Slide 1 of 34.">
<meta property="og:type" content="article">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%239aa1ae'/%3E%3Crect x='2' y='3' width='12' height='10' fill='%23ffffff' stroke='%23808080'/%3E%3Crect x='4' y='5' width='8' height='2' fill='%231f3f94'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
<style>
/* ============================================================
   THEME THUNDER № 10 — "SLIDES 2003"
   A coalition update brief, March 2003, opened on a Luna-blue
   desktop. Arial, UNCLASSIFIED bars, an embedded worksheet,
   process chevrons, and a Questions slide. No animations —
   the deck loads instantly, like all good briefings claim to.
   ============================================================ */
:root {
  --workspace: #9aa1ae;   /* normal-view canvas */
  --menu:      #ece9d8;   /* XP chrome tan */
  --menu-edge: #aca899;
  --slide:     #ffffff;
  --ink:       #1a1a1a;
  --ppt-blue:  #1f3f94;   /* title + banner blue */
  --ppt-blue-2:#4a6fc4;
  --key:       #e8a33d;   /* the orange chevron */
  --unclass:   #006b3c;   /* classification green */
  --link:      #1414cc;   /* period hyperlink blue */
  --shadow:    #6f7683;
}
* { box-sizing: border-box; }
html { background: var(--workspace); }
body {
  margin: 0;
  background: var(--workspace);
  color: var(--ink);
  font-family: Arial, "Arimo", "Helvetica Neue", sans-serif;
  font-size: 1rem;
  line-height: 1.62;
}
a { color: var(--link); text-decoration: underline; }
a:hover { color: #000a8c; }
::selection { background: #316ac5; color: #fff; }
.wrap { max-width: 46rem; margin-inline: auto; padding-inline: 1rem; }

/* --- window chrome ----------------------------------------- */
.winbar {
  background: linear-gradient(180deg, #5a96f7 0%, #2166d1 8%, #1c55b8 55%, #123c8c 100%);
  color: #fff; font-family: Tahoma, "Arimo", sans-serif; font-weight: 700;
  font-size: 0.82rem; padding: 0.35rem 0.6rem;
  display: flex; align-items: center; gap: 0.5rem;
  text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.45);
}
.winbar .doc { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.winbar .btn {
  width: 1.15rem; height: 1.05rem; border: 1px solid #fff; border-radius: 2px;
  display: inline-grid; place-items: center; font-size: 0.68rem; font-weight: 700;
  background: linear-gradient(180deg, #7aa9f5, #2b64c4);
}
.winbar .btn--close { background: linear-gradient(180deg, #f0a08c, #c93c1e); }
.menubar {
  background: var(--menu); border-bottom: 1px solid var(--menu-edge);
  font-family: Tahoma, "Arimo", sans-serif; font-size: 0.76rem;
  padding: 0.28rem 0.6rem; display: flex; flex-wrap: wrap; gap: 0.15rem 1rem;
  align-items: center; color: #1a1a1a;
}
.menubar .ask {
  margin-left: auto; background: #fff; border: 1px solid var(--menu-edge);
  color: #7a766a; padding: 0.06rem 0.5rem; font-size: 0.72rem;
}
.menubar a { color: inherit; text-decoration: none; }
.menubar a.live { color: var(--link); text-decoration: underline; }

/* --- slides ------------------------------------------------ */
.slide {
  background: var(--slide); max-width: 46rem; margin: 1.7rem auto;
  border: 1px solid #6f7683; box-shadow: 3px 3px 0 rgba(90, 96, 107, 0.55);
}
.classbar {
  background: var(--unclass); color: #fff; text-align: center;
  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.28em;
  padding: 0.22rem 0;
}
.slide--title .inner { padding: 2.6rem 2.6rem 1.2rem; text-align: center; }
h1.deckname {
  margin: 0.8rem 0 0.4rem; color: var(--ppt-blue);
  font-size: clamp(1.7rem, 4.6vw, 2.5rem); line-height: 1.15; font-weight: 700;
}
.deckrule {
  height: 0.35rem; max-width: 26rem; margin: 0.9rem auto 1.3rem;
  background: linear-gradient(90deg, var(--ppt-blue), #8ba3dd 85%, transparent);
}
.deck-kicker { margin: 0; font-size: 0.8rem; letter-spacing: 0.18em; color: #555; text-transform: uppercase; }
.dek-block { font-style: italic; color: #333; font-size: 1rem; margin: 0 auto 1.5rem; max-width: 36rem; }
.opline {
  display: flex; flex-wrap: wrap; justify-content: center; gap: 0.3rem 1.8rem;
  font-size: 0.78rem; color: #444; margin: 0 0 1.6rem;
}
.opline b { font-weight: 700; }
.slide-foot {
  display: flex; justify-content: space-between; align-items: center;
  padding: 0.4rem 0.9rem; font-size: 0.72rem; color: #888;
}

/* --- the deck body (article feed) -------------------------- */
.deck { max-width: 46rem; margin: 0 auto; padding-inline: 1rem; }
.feed {
  background: var(--slide); border: 1px solid #6f7683;
  box-shadow: 3px 3px 0 rgba(90, 96, 107, 0.55);
  padding: 1.7rem 2.6rem 2.2rem;
  counter-reset: slide 2;
}
.feed p { margin: 0 0 1.05em; }
.feed h2 {
  counter-increment: slide;
  margin: 0 -2.6rem 1.2rem; padding: 0.65rem 2.6rem;
  border-top: 2.4rem solid var(--workspace);
  background: linear-gradient(90deg, var(--ppt-blue), var(--ppt-blue-2));
  color: #fff; font-size: 1.18rem; font-weight: 700; letter-spacing: 0.01em;
  display: flex; align-items: baseline; gap: 1rem;
}
.feed h2::after {
  content: "Slide " counter(slide); margin-left: auto;
  font-size: 0.68rem; font-weight: 400; opacity: 0.75; white-space: nowrap;
}
.feed a:hover { background: none; }
.feed .dinkus { text-align: center; color: #999; letter-spacing: 1.2em; margin: 1.6em 0; }
/* factbox → embedded worksheet */
.feed .factbox {
  border: 1px solid #808080; margin: 1.8em 0; font-size: 0.86rem;
  box-shadow: 3px 3px 0 rgba(128, 128, 128, 0.35);
}
.feed .factbox-title {
  margin: 0; padding: 0.4rem 0.7rem; background: #d4d0c8;
  border-bottom: 1px solid #808080; font-size: 0.8rem; font-weight: 700;
  color: #1a1a1a;
}
.feed .factbox-title::before { content: "Worksheet — "; font-weight: 400; color: #555; }
.feed .factbox dl { margin: 0; }
.feed .factbox .row { display: flex; border-bottom: 1px solid #d7d7d7; }
.feed .factbox .row:last-child { border-bottom: 0; }
.feed .factbox dt {
  flex: 0 0 44%; padding: 0.38rem 0.7rem; background: #f4f3ef;
  border-right: 1px solid #d7d7d7; color: #333;
}
.feed .factbox dd { margin: 0; padding: 0.38rem 0.7rem; flex: 1; text-align: right; font-weight: 700; }
/* pullquote → AutoShape callout */
.feed .pullquote {
  background: #ffffcc; border: 1px solid #808080;
  box-shadow: 4px 4px 0 rgba(128, 128, 128, 0.4);
  margin: 2.2em 1rem 2.6em; padding: 1.05rem 1.3rem; position: relative;
}
.feed .pullquote::after {
  content: ""; position: absolute; left: 2.2rem; bottom: -0.95rem;
  border-left: 1rem solid #808080; border-bottom: 1rem solid transparent;
}
.feed .pullquote::before {
  content: ""; position: absolute; left: calc(2.2rem + 1px); bottom: -0.82rem;
  border-left: 0.9rem solid #ffffcc; border-bottom: 0.9rem solid transparent;
  z-index: 1;
}
.feed .pullquote p { margin: 0; font-style: italic; font-size: 1.05rem; line-height: 1.5; }
.feed .pullquote cite {
  display: block; margin-top: 0.55rem; font-style: normal; font-size: 0.78rem;
  color: #555; text-align: right;
}
.feed .pullquote cite::before { content: "— "; }

/* --- process chevrons (timeline) --------------------------- */
.eventlog {
  background: var(--slide); border: 1px solid #6f7683;
  box-shadow: 3px 3px 0 rgba(90, 96, 107, 0.55);
  max-width: 46rem; margin: 1.7rem auto; padding: 0 2.6rem 1.8rem;
}
.log-head {
  margin: 0 -2.6rem 0.4rem; padding: 0.65rem 2.6rem;
  background: linear-gradient(90deg, var(--ppt-blue), var(--ppt-blue-2));
  color: #fff; font-size: 1.18rem; font-weight: 700;
}
.log-sub { color: #555; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; margin: 1rem 0 1.2rem; }
.eventlog ol { list-style: none; margin: 0; padding: 0; }
.eventlog li {
  display: grid; grid-template-columns: 10.5rem 1fr; gap: 0.2rem 1.3rem;
  padding: 0.8rem 0; border-bottom: 1px solid #e4e4e4; font-size: 0.92rem;
}
.eventlog li:last-child { border-bottom: 0; }
.eventlog .d {
  align-self: start; background: linear-gradient(180deg, #4a6fc4, var(--ppt-blue));
  color: #fff; font-weight: 700; font-size: 0.74rem; line-height: 1.3;
  padding: 0.45rem 1.3rem 0.45rem 0.7rem;
  clip-path: polygon(0 0, calc(100% - 0.8rem) 0, 100% 50%, calc(100% - 0.8rem) 100%, 0 100%);
}
.eventlog li.key { background: #fff7e6; }
.eventlog li.key .d { background: linear-gradient(180deg, #f2b95c, var(--key)); color: #4a3000; }
.eventlog h3 { grid-column: 2; margin: 0; font-size: 0.98rem; font-weight: 700; color: var(--ppt-blue); }
.eventlog .d + h3 { grid-column: auto; }
.eventlog p { grid-column: 2; margin: 0.25rem 0 0; color: #333; }
@media (max-width: 40rem) {
  .eventlog li { grid-template-columns: 1fr; }
  .eventlog h3, .eventlog p { grid-column: 1; }
  .eventlog .d { justify-self: start; }
}

/* --- backup slide (sources) + questions slide -------------- */
.refs {
  background: var(--slide); border: 1px solid #6f7683;
  box-shadow: 3px 3px 0 rgba(90, 96, 107, 0.55);
  max-width: 46rem; margin: 1.7rem auto; padding: 0 2.6rem 1.6rem;
  font-size: 0.86rem;
}
.refs h2 {
  margin: 0 -2.6rem 1.1rem; padding: 0.65rem 2.6rem;
  background: linear-gradient(90deg, #5a5f6b, #8a8f9a);
  color: #fff; font-size: 1.05rem; font-weight: 700;
}
.refs h2::before { content: "Backup — "; font-weight: 400; opacity: 0.8; }
.refs ol { margin: 0; padding-left: 1.4rem; color: #333; }
.refs li { margin-bottom: 0.45rem; }
.exit {
  background: var(--slide); border: 1px solid #6f7683;
  box-shadow: 3px 3px 0 rgba(90, 96, 107, 0.55);
  max-width: 46rem; margin: 1.7rem auto 2.4rem; padding: 2.8rem 2.6rem 2.4rem;
  text-align: center;
}
.exit .prompt {
  margin: 0 0 1.6rem; color: var(--ppt-blue);
  font-size: clamp(1.7rem, 4.5vw, 2.3rem); font-weight: 700; letter-spacing: 0.04em;
}
.exit ul {
  list-style: none; margin: 0; padding: 0;
  display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem 2rem;
  font-size: 0.9rem;
}
/* --- status bar -------------------------------------------- */
.xpstatus {
  background: var(--menu); border-top: 1px solid var(--menu-edge);
  font-family: Tahoma, "Arimo", sans-serif; font-size: 0.74rem; color: #333;
  padding: 0.3rem 0.8rem; display: flex; flex-wrap: wrap; gap: 0.2rem 2.4rem;
}
</style>
</head>
<body>

<div class="winbar" role="presentation">
  <span class="doc">Microsoft PowerPoint — [OIF_update_brief_v12_FINAL_final(2).ppt] — Read-Only</span>
  <span class="btn" aria-hidden="true">_</span><span class="btn" aria-hidden="true">□</span><span class="btn btn--close" aria-hidden="true">✕</span>
</div>
<nav class="menubar" aria-label="Edition chrome">
  <span>File</span><span>Edit</span><span>View</span><span>Insert</span><span>Format</span><span>Tools</span><span>Slide&nbsp;Show</span><span>Window</span><span>Help</span>
  <a class="live" href="{{ art.url }}">Standard edition →</a>
  <span class="ask">Type a question for help</span>
</nav>

<header class="slide slide--title">
  <div class="classbar">UNCLASSIFIED</div>
  <div class="inner">
    <p class="deck-kicker">{{ site.name }} // Theme Thunder № 10 · Commander's Update</p>
    <h1 class="deckname">The War on Bullet Points:<br>Iraq, 2003</h1>
    <div class="deckrule" aria-hidden="true"></div>
    <p class="dek-block">{{ art.data.dek }}</p>
    <p class="opline">
      <span>FILE: <b>{{ art.data.fileNo }}</b></span>
      <span>DESK: <b>ANALYSIS</b></span>
      <span>POSTED: <b>{{ art.date | readableDate }}</b></span>
      <span>SOURCES: <b>OPEN // DECLASSIFIED</b></span>
    </p>
  </div>
  <div class="slide-foot"><span>Style reconstruction · sample copy</span><span>1</span></div>
  <div class="classbar">UNCLASSIFIED</div>
</header>

<div class="deck">
  <article class="feed" aria-label="Article, slide-deck edition">
{{ art.templateContent | safe }}
  </article>
</div>

{%- if art.data.timeline %}
<section class="eventlog" aria-label="Process timeline">
  <h2 class="log-head">Roadmap</h2>
  <p class="log-sub">{{ art.data.timeline.title }}</p>
  <ol>
    {%- for item in art.data.timeline.items %}
    <li{% if item.key %} class="key"{% endif %}>
      <span class="d">{{ item.date }}</span>
      <h3>{{ item.title }}</h3>
      <p>{{ item.text }}</p>
    </li>
    {%- endfor %}
  </ol>
</section>
{%- endif %}

{%- if art.data.sources %}
<section class="refs" aria-label="Sources">
  <h2>Sources</h2>
  <ol>
    {%- for s in art.data.sources %}
    <li>{{ s | safe }}</li>
    {%- endfor %}
  </ol>
</section>
{%- endif %}

<footer class="exit">
  <p class="prompt">QUESTIONS?</p>
  <ul>
    <li><a href="{{ art.url }}">Standard edition</a></li>
    <li><a href="/thunder/">Theme Thunder index</a></li>
    <li><a href="/">{{ site.name }} front page</a></li>
  </ul>
</footer>

<div class="xpstatus" role="presentation">
  <span>Slide 34 of 34</span><span>Default Design</span><span>English (U.S.)</span>
</div>

</body>
</html>
