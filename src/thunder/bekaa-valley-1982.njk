---
title: "SCOPE 1982 · Bekaa Valley — Theme Thunder"
---
{%- set art = collections.articles | articleBySlug("bekaa-valley-1982") -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — {{ site.name }}</title>
<meta name="description" content="{{ art.data.dek }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ art.data.title }} — Theme Thunder edition">
<meta property="og:description" content="Theme Thunder: the Bekaa Valley air battles replayed on a 1982 ground-controlled-intercept console.">
<meta property="og:type" content="article">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%23030a05'/%3E%3Crect x='2' y='2' width='12' height='12' fill='none' stroke='%233aff77'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=VT323&display=swap" rel="stylesheet">
<style>
/* ============================================================
   THEME THUNDER № 1 — "SCOPE 1982"
   A ground-controlled-intercept console, eastern Mediterranean,
   June 1982. Green phosphor, slow sweep, replayed track data.
   ============================================================ */
:root {
  --tube:      #030a05;   /* dead screen */
  --tube-2:    #06140a;   /* raised panel */
  --phos:      #3aff77;   /* bright phosphor */
  --phos-soft: #b9f5cc;   /* long-persistence body text */
  --phos-dim:  #46915f;   /* labels, chrome */
  --phos-ghost:#1c4a2e;   /* rules, rings */
  --amber:     #ffb000;   /* threat / key data */
  --measure: 41rem;
}
* { box-sizing: border-box; }
html { background: #010401; }
body {
  margin: 0;
  background:
    radial-gradient(ellipse 120% 90% at 50% 0%, #07180c 0%, var(--tube) 55%);
  color: var(--phos-soft);
  font-family: "Share Tech Mono", ui-monospace, Menlo, monospace;
  font-size: 1.03rem;
  line-height: 1.72;
  min-height: 100vh;
}
/* --- CRT furniture ----------------------------------------- */
.crt::before {
  content: "";
  position: fixed; inset: 0; transform: translateZ(0);
  background: repeating-linear-gradient(0deg,
    rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px);
  pointer-events: none; z-index: 40;
}
.crt::after {
  content: "";
  position: fixed; inset: 0; transform: translateZ(0);
  background: radial-gradient(ellipse 95% 85% at 50% 45%,
    transparent 60%, rgba(0, 0, 0, 0.55) 100%);
  pointer-events: none; z-index: 41;
}
a { color: var(--amber); text-decoration: none; }
a:hover { background: var(--amber); color: var(--tube); }
::selection { background: var(--phos); color: var(--tube); }
.wrap { max-width: 62rem; margin-inline: auto; padding-inline: 1.25rem; }

/* --- status bar -------------------------------------------- */
.statusbar {
  border-bottom: 1px solid var(--phos-ghost);
  font-size: 0.82rem; letter-spacing: 0.14em;
  color: var(--phos-dim); text-transform: uppercase;
}
.statusbar .wrap {
  display: flex; flex-wrap: wrap; gap: 0.35rem 1.6rem;
  justify-content: space-between; padding-block: 0.55rem;
}
.statusbar b { color: var(--phos); font-weight: 400; }
.statusbar a { color: var(--phos-dim); }
.statusbar a:hover { background: var(--phos-dim); color: var(--tube); }

/* --- console header ---------------------------------------- */
.console-head { padding-block: 3rem 2rem; text-align: left; }
.boot {
  color: var(--phos-dim); font-size: 0.85rem; letter-spacing: 0.12em;
  margin: 0 0 1.6rem; text-transform: uppercase;
}
.boot b { color: var(--amber); font-weight: 400; }
h1.trackname {
  font-family: "VT323", monospace;
  font-size: clamp(2.6rem, 7vw, 4.6rem);
  line-height: 0.98; margin: 0 0 1.2rem;
  color: var(--phos); text-transform: uppercase; font-weight: 400;
  text-shadow: 0 0 14px rgba(58, 255, 119, 0.45);
}
.dek-block {
  border-left: 3px double var(--phos-ghost);
  padding-left: 1.1rem; max-width: var(--measure);
  color: var(--phos-soft); font-size: 0.98rem; margin: 0 0 1.4rem;
}
.opline {
  display: flex; flex-wrap: wrap; gap: 0.4rem 2rem;
  font-size: 0.82rem; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--phos-dim);
}
.opline b { color: var(--phos); font-weight: 400; }

/* --- radar scope ------------------------------------------- */
.scopebay { display: grid; place-items: center; padding-block: 1.4rem 2.4rem; }
.scope {
  position: relative; width: min(30rem, 92vw); aspect-ratio: 1;
  border-radius: 50%;
  background:
    repeating-radial-gradient(circle at 50% 50%,
      transparent 0 23.5%, var(--phos-ghost) 23.5% 24%, transparent 24% 48%),
    radial-gradient(circle at 50% 50%, #0a2413 0%, #051207 62%, #030a05 100%);
  box-shadow: 0 0 0 4px #0c1c10, 0 0 0 6px #1c3423, 0 0 60px rgba(58,255,119,0.12),
    inset 0 0 55px rgba(0, 0, 0, 0.75);
}
.scope::before, .scope::after {
  content: ""; position: absolute; background: var(--phos-ghost);
}
.scope::before { inset: 50% 3% auto 3%; height: 1px; }
.scope::after  { inset: 3% 50% 3% auto; width: 1px; }
.sweep {
  position: absolute; inset: 0; border-radius: 50%; overflow: hidden;
  animation: sweep 6s linear infinite;
  background: conic-gradient(from 0deg,
    rgba(58, 255, 119, 0.55) 0deg, rgba(58, 255, 119, 0.10) 28deg,
    transparent 55deg, transparent 360deg);
  mix-blend-mode: screen;
}
@keyframes sweep { to { transform: rotate(360deg); } }
.blip {
  position: absolute; width: 7px; height: 7px; background: var(--phos);
  box-shadow: 0 0 8px 2px rgba(58, 255, 119, 0.55);
  animation: persist 6s linear infinite;
}
.blip--sam { background: var(--amber); box-shadow: 0 0 8px 2px rgba(255, 176, 0, 0.5); }
.blip span {
  position: absolute; left: 10px; top: -4px; white-space: nowrap;
  font-size: 0.62rem; letter-spacing: 0.12em; color: var(--phos-dim);
}
@keyframes persist {
  0%, 12% { opacity: 1; } 70% { opacity: 0.25; } 100% { opacity: 1; }
}
.scope .ring-label {
  position: absolute; font-size: 0.6rem; letter-spacing: 0.14em;
  color: var(--phos-dim);
}
.scope-caption {
  margin: 1rem auto 0; max-width: 30rem; text-align: center;
  font-size: 0.78rem; letter-spacing: 0.1em; color: var(--phos-dim);
  text-transform: uppercase;
}
@media (prefers-reduced-motion: reduce) {
  .sweep { animation: none; transform: rotate(300deg); }
  .blip { animation: none; }
}

/* --- article feed ------------------------------------------ */
.feed { max-width: var(--measure); margin-inline: auto; padding-bottom: 2rem; }
.feed p { margin: 0 0 1.15em; }
.feed h2 {
  font-family: "VT323", monospace; font-weight: 400;
  color: var(--phos); font-size: 1.9rem; letter-spacing: 0.04em;
  text-transform: uppercase; margin: 2.6em 0 0.7em;
  text-shadow: 0 0 10px rgba(58, 255, 119, 0.35);
}
.feed h2::before { content: ">> "; color: var(--phos-dim); }
.feed em { font-style: normal; color: var(--phos); }
.feed strong { color: var(--phos); font-weight: 400; }
.feed .dinkus {
  text-align: center; color: var(--phos-dim); letter-spacing: 1.2em;
  margin: 2em 0;
}
/* factbox → DATA BLOCK */
.feed .factbox {
  border: 1px solid var(--phos-dim); margin: 2em 0; font-size: 0.9rem;
  background: rgba(6, 20, 10, 0.8);
}
.feed .factbox-title {
  margin: 0; padding: 0.45rem 0.9rem; background: var(--phos-dim);
  color: var(--tube); font-size: 0.85rem; font-weight: 400;
  letter-spacing: 0.22em; text-transform: uppercase;
}
.feed .factbox-title::before { content: "DATA BLOCK // "; }
.feed .factbox dl { margin: 0; padding: 0.5rem 0.9rem 0.7rem; }
.feed .factbox .row {
  display: flex; justify-content: space-between; gap: 1.5rem;
  padding: 0.42rem 0; border-bottom: 1px dashed var(--phos-ghost);
}
.feed .factbox .row:last-child { border-bottom: 0; }
.feed .factbox dt { color: var(--phos-dim); text-transform: uppercase; font-size: 0.78rem; letter-spacing: 0.1em; padding-top: 0.15em; }
.feed .factbox dd { margin: 0; text-align: right; color: var(--phos); }
/* pullquote → INTERCEPT */
.feed .pullquote {
  border: 1px dashed var(--amber); border-left: 4px solid var(--amber);
  padding: 1rem 1.2rem; margin: 2em 0; position: relative;
}
.feed .pullquote::before {
  content: "INTERCEPT // VOICE NET"; display: block;
  color: var(--amber); font-size: 0.72rem; letter-spacing: 0.26em;
  margin-bottom: 0.6rem;
}
.feed .pullquote p {
  margin: 0; color: var(--phos); font-size: 1.12rem; line-height: 1.55;
  text-transform: uppercase;
}
.feed .pullquote cite {
  display: block; margin-top: 0.7rem; font-style: normal;
  color: var(--phos-dim); font-size: 0.78rem; letter-spacing: 0.14em;
  text-transform: uppercase;
}
.feed .pullquote cite::before { content: "SOURCE: "; }

/* --- event log (timeline) ---------------------------------- */
.eventlog { max-width: var(--measure); margin: 3rem auto 0; }
.log-head {
  font-family: "VT323", monospace; font-weight: 400; font-size: 1.9rem;
  color: var(--phos); text-transform: uppercase; margin: 0 0 0.4rem;
  text-shadow: 0 0 10px rgba(58, 255, 119, 0.35);
}
.log-head::before { content: ">> "; color: var(--phos-dim); }
.log-sub { color: var(--phos-dim); font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; margin: 0 0 1.4rem; }
.eventlog ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--phos-ghost); }
.eventlog li {
  display: grid; grid-template-columns: 9.5rem 1fr; gap: 0.2rem 1.4rem;
  padding: 0.95rem 0.6rem; border-bottom: 1px solid var(--phos-ghost);
  font-size: 0.92rem;
}
.eventlog li.key { background: rgba(58, 255, 119, 0.07); border-left: 3px solid var(--amber); }
.eventlog .d { color: var(--amber); letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.82rem; padding-top: 0.2em; }
.eventlog h3 { grid-column: 2; margin: 0; font-size: 0.95rem; font-weight: 400; color: var(--phos); text-transform: uppercase; letter-spacing: 0.06em; }
.eventlog .d + h3 { grid-column: auto; }
.eventlog p { grid-column: 2; margin: 0.25rem 0 0; color: var(--phos-soft); }
@media (max-width: 40rem) {
  .eventlog li { grid-template-columns: 1fr; }
  .eventlog h3, .eventlog p { grid-column: 1; }
}

/* --- references + exit ------------------------------------- */
.refs { max-width: var(--measure); margin: 3rem auto 0; font-size: 0.85rem; }
.refs h2 {
  font-family: "VT323", monospace; font-weight: 400; font-size: 1.6rem;
  color: var(--phos); text-transform: uppercase; margin: 0 0 0.8rem;
}
.refs h2::before { content: ">> "; color: var(--phos-dim); }
.refs ol { margin: 0; padding-left: 1.6rem; color: var(--phos-dim); }
.refs li { margin-bottom: 0.4rem; }
.refs em { font-style: normal; color: var(--phos-soft); }
.exit {
  max-width: var(--measure); margin: 3.5rem auto 0; padding-block: 2rem 3.5rem;
  border-top: 1px solid var(--phos-ghost);
  font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase;
}
.exit p { margin: 0 0 1.2rem; color: var(--phos-dim); }
.exit .prompt::after { content: "█"; animation: blink 1.1s steps(1) infinite; color: var(--phos); }
@keyframes blink { 50% { opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .exit .prompt::after { animation: none; } }
.exit ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.7rem 2rem; }
.exit a { color: var(--phos); }
.exit a:hover { background: var(--phos); color: var(--tube); }
</style>
</head>
<body class="crt">

<div class="statusbar">
  <div class="wrap">
    <span><b>{{ site.name }}</b> // THEME THUNDER № 1</span>
    <span>MODE: <b>REPLAY</b> · TRACK DATA 09–11 JUN 82</span>
    <span><a href="{{ art.url }}">STANDARD EDITION →</a></span>
  </div>
</div>

<header class="console-head wrap">
  <p class="boot">GCI STATION // NORTHERN SECTOR // TUBE 4 ······ SYS <b>UP</b> · JAM <b>ACTIVE</b> · IFF <b>GREEN</b></p>
  <h1 class="trackname">Operation<br>Mole Cricket 19</h1>
  <p class="dek-block">{{ art.data.dek }}</p>
  <p class="opline">
    <span>FILE: <b>{{ art.data.fileNo }}</b></span>
    <span>DESK: <b>AIR WARFARE</b></span>
    <span>POSTED: <b>{{ art.date | readableDate }}</b></span>
    <span>SOURCES: <b>OPEN // UNCLASSIFIED</b></span>
  </p>
</header>

<div class="scopebay wrap">
  <div>
    <div class="scope" role="img" aria-label="Stylised radar scope of the Bekaa Valley engagement: Syrian surface-to-air-missile groups plotted mid-valley, Israeli strike and fighter tracks inbound from the south-west.">
      <div class="sweep" aria-hidden="true"></div>
      <span class="ring-label" style="top: 4.5%; left: 51%;">000</span>
      <span class="ring-label" style="top: 49%; right: 2.5%;">090</span>
      <span class="ring-label" style="bottom: 4.5%; left: 50%;">180</span>
      <span class="ring-label" style="top: 49%; left: 2.5%;">270</span>
      <i class="blip blip--sam" style="top: 38%; left: 58%; animation-delay: -1.1s;"><span>SA-6 GRP 1</span></i>
      <i class="blip blip--sam" style="top: 46%; left: 63%; animation-delay: -1.4s;"><span>SA-6 GRP 2</span></i>
      <i class="blip blip--sam" style="top: 55%; left: 59%; animation-delay: -1.8s;"><span>SA-2/3</span></i>
      <i class="blip" style="top: 63%; left: 30%; animation-delay: -3.6s;"><span>STRIKE PKG A</span></i>
      <i class="blip" style="top: 72%; left: 40%; animation-delay: -4.1s;"><span>PKG B</span></i>
      <i class="blip" style="top: 20%; left: 72%; animation-delay: -0.4s;"><span>MIG-23 PAIR</span></i>
      <i class="blip" style="top: 84%; left: 55%; animation-delay: -4.6s;"><span>E-2C ORBIT</span></i>
    </div>
    <p class="scope-caption">PPI DISPLAY · RANGE 80 NM · BEKAA VALLEY GRID · 1512 LOCAL, 9 JUNE 1982</p>
  </div>
</div>

<article class="feed wrap" aria-label="Article, console edition">
{{ art.templateContent | safe }}
</article>

{%- if art.data.timeline %}
<section class="eventlog wrap" aria-label="Event log">
  <h2 class="log-head">Event Log</h2>
  <p class="log-sub">{{ art.data.timeline.title }}</p>
  <ol>
    {%- for item in art.data.timeline.items %}
    <li{% if item.key %} class="key"{% endif %}>
      <span class="d">{{ item.date }}</span>
      <h3>{{ item.title }}</h3>
      <p>{{ item.text }}</p>
    </li>
    {%- endfor %}
  </ol>
</section>
{%- endif %}

{%- if art.data.sources %}
<section class="refs wrap" aria-label="Sources">
  <h2>Reference Index</h2>
  <ol>
    {%- for s in art.data.sources %}
    <li>{{ s | safe }}</li>
    {%- endfor %}
  </ol>
</section>
{%- endif %}

<footer class="exit wrap">
  <p class="prompt">END OF TRACK REPLAY. AWAITING INPUT </p>
  <ul>
    <li><a href="{{ art.url }}">[ STANDARD EDITION ]</a></li>
    <li><a href="/thunder/">[ THEME THUNDER INDEX ]</a></li>
    <li><a href="/">[ {{ site.name }} FRONT PAGE ]</a></li>
  </ul>
</footer>

</body>
</html>
