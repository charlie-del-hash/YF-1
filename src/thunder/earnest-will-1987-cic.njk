---
title: "CIC 1987 · First Convoy — Theme Thunder"
---
{%- set art = collections.articles | articleBySlug("earnest-will-1987") -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — {{ site.name }}</title>
<meta name="description" content="{{ art.data.dek }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ art.data.title }} — Theme Thunder edition">
<meta property="og:description" content="Theme Thunder: Earnest Will's first convoy on a combat-information-center plot — blue-white phosphor, NTDS symbols, a mine datum ahead of the column.">
<meta property="og:type" content="article">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%2304070e'/%3E%3Ccircle cx='6' cy='9' r='3' fill='none' stroke='%23cfe2ff'/%3E%3Crect x='9.5' y='2.5' width='4' height='4' fill='none' stroke='%23ff5a4e' transform='rotate(45 11.5 4.5)'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@600&family=Fragment+Mono&display=swap" rel="stylesheet">
<style>
/* ============================================================
   THEME THUNDER № 12 — "CIC 1987"
   A combat information center in the central Gulf, first light,
   24 July 1987. Blue-white phosphor, NTDS symbology, a convoy
   in column and a mine datum where the channel narrows.
   ============================================================ */
:root {
  --tube:      #04070e;   /* dead screen */
  --tube-2:    #0a1424;   /* raised panel */
  --phos:      #cfe2ff;   /* blue-white phosphor */
  --phos-soft: #b9cdec;   /* body text */
  --phos-dim:  #56719f;   /* labels, chrome */
  --phos-ghost:#1a2b47;   /* rules, rings */
  --alert:     #ff5a4e;   /* hostile / key data */
  --unk:       #ffcf5c;   /* unknown, evaluated */
  --measure: 41rem;
}
* { box-sizing: border-box; }
html { background: #020409; }
body {
  margin: 0;
  background:
    radial-gradient(ellipse 120% 90% at 50% 0%, #0b1830 0%, var(--tube) 55%);
  color: var(--phos-soft);
  font-family: "Fragment Mono", ui-monospace, Menlo, monospace;
  font-size: 0.98rem;
  line-height: 1.72;
  min-height: 100vh;
}
/* --- CRT furniture ----------------------------------------- */
.crt::before {
  content: "";
  position: fixed; inset: 0; transform: translateZ(0);
  background: repeating-linear-gradient(0deg,
    rgba(0, 0, 0, 0.22) 0 1px, transparent 1px 3px);
  pointer-events: none; z-index: 40;
}
.crt::after {
  content: "";
  position: fixed; inset: 0; transform: translateZ(0);
  background: radial-gradient(ellipse 95% 85% at 50% 45%,
    transparent 60%, rgba(0, 0, 0, 0.55) 100%);
  pointer-events: none; z-index: 41;
}
a { color: var(--unk); text-decoration: none; }
a:hover { background: var(--unk); color: var(--tube); }
::selection { background: var(--phos); color: var(--tube); }
.wrap { max-width: 62rem; margin-inline: auto; padding-inline: 1.25rem; }

/* --- status bar -------------------------------------------- */
.statusbar {
  border-bottom: 1px solid var(--phos-ghost);
  font-size: 0.8rem; letter-spacing: 0.14em;
  color: var(--phos-dim); text-transform: uppercase;
}
.statusbar .wrap {
  display: flex; flex-wrap: wrap; gap: 0.35rem 1.6rem;
  justify-content: space-between; padding-block: 0.55rem;
}
.statusbar b { color: var(--phos); font-weight: 400; }
.statusbar a { color: var(--phos-dim); }
.statusbar a:hover { background: var(--phos-dim); color: var(--tube); }

/* --- console header ---------------------------------------- */
.console-head { padding-block: 3rem 2rem; text-align: left; }
.boot {
  color: var(--phos-dim); font-size: 0.85rem; letter-spacing: 0.12em;
  margin: 0 0 1.6rem; text-transform: uppercase;
}
.boot b { color: var(--alert); font-weight: 400; }
h1.trackname {
  font-family: "Chakra Petch", sans-serif; font-weight: 600;
  font-size: clamp(2.3rem, 6.4vw, 4rem);
  line-height: 1.04; margin: 0 0 1.2rem;
  color: var(--phos); text-transform: uppercase; letter-spacing: 0.04em;
  text-shadow: 0 0 16px rgba(207, 226, 255, 0.4);
}
.dek-block {
  border-left: 3px double var(--phos-ghost);
  padding-left: 1.1rem; max-width: var(--measure);
  color: var(--phos-soft); font-size: 0.96rem; margin: 0 0 1.4rem;
}
.opline {
  display: flex; flex-wrap: wrap; gap: 0.4rem 2rem;
  font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--phos-dim);
}
.opline b { color: var(--phos); font-weight: 400; }

/* --- the plot ---------------------------------------------- */
.plotbay { padding-block: 1.4rem 2.4rem; }
.plot {
  display: grid; grid-template-columns: 1.5fr 1fr; gap: 1.4rem; align-items: stretch;
}
.chart {
  border: 1px solid var(--phos-ghost); padding: 0.8rem;
  background: radial-gradient(circle at 50% 45%, #0a1526 0%, #060b16 70%);
  box-shadow: 0 0 0 4px #081020, 0 0 0 5px #16294a,
    0 0 60px rgba(207, 226, 255, 0.07), inset 0 0 45px rgba(0, 0, 0, 0.7);
}
.chart svg { display: block; width: 100%; height: auto; }
.chart .ring { stroke: var(--phos-ghost); fill: none; stroke-width: 1; }
.chart .coast { stroke: #3b567f; fill: none; stroke-width: 1.3; stroke-linejoin: round; }
.chart .isle { fill: #16233c; stroke: #3b567f; stroke-width: 1.2; }
.chart .lane { stroke: var(--phos-ghost); stroke-dasharray: 7 6; fill: none; }
.chart .frnd { stroke: var(--phos); fill: none; stroke-width: 1.6; }
.chart .frnd-dot { fill: var(--phos); }
.chart .ldr { stroke: var(--phos); stroke-width: 1; }
.chart .unkn {
  stroke: var(--unk); fill: none; stroke-width: 1.6;
}
.chart .host {
  stroke: var(--alert); fill: none; stroke-width: 1.6;
  animation: hblink 1.1s steps(1) infinite;
}
.chart .host-ldr { stroke: var(--alert); stroke-width: 1; animation: hblink 1.1s steps(1) infinite; }
@keyframes hblink { 50% { opacity: 0.3; } }
.chart .datum { stroke: var(--alert); stroke-width: 1.6; }
.chart .datum-ring { stroke: var(--alert); stroke-dasharray: 4 4; fill: none; opacity: 0.7; }
.chart .lbl {
  font-family: "Fragment Mono", monospace; font-size: 8.5px;
  fill: var(--phos-dim); letter-spacing: 0.1em;
}
.chart .lbl--trk { fill: var(--phos); }
.chart .lbl--hot { fill: var(--alert); }
.chart .refresh { animation: plotref 2.4s steps(1) infinite; }
@keyframes plotref { 0%, 91% { opacity: 1; } 94% { opacity: 0.55; } 97%, 100% { opacity: 1; } }
/* readout rack */
.rack { display: flex; flex-direction: column; gap: 0.9rem; }
.stat {
  border: 1px solid var(--phos-ghost); padding: 0.75rem 0.95rem;
  font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--phos-dim);
}
.stat b {
  display: block; font-weight: 600; color: var(--phos);
  font-family: "Chakra Petch", sans-serif; font-size: 1.02rem;
  margin-top: 0.35rem; letter-spacing: 0.08em;
}
.stat--alert { border-color: var(--alert); background: rgba(255, 90, 78, 0.07); }
.stat--alert b { color: var(--alert); animation: hblink 1.1s steps(1) infinite; }
.stat--calm b { color: var(--phos-soft); }
.plot-caption {
  margin: 1rem 0 0; text-align: center;
  font-size: 0.78rem; letter-spacing: 0.1em; color: var(--phos-dim);
  text-transform: uppercase;
}
@media (max-width: 52rem) {
  .plot { grid-template-columns: 1fr; }
  .rack { flex-direction: row; flex-wrap: wrap; }
  .rack .stat { flex: 1 1 12rem; }
}
@media (prefers-reduced-motion: reduce) {
  .chart .host, .chart .host-ldr, .chart .refresh, .stat--alert b { animation: none; }
}

/* --- article feed ------------------------------------------ */
.feed { max-width: var(--measure); margin-inline: auto; padding-bottom: 2rem; }
.feed p { margin: 0 0 1.15em; }
.feed h2 {
  font-family: "Chakra Petch", sans-serif; font-weight: 600;
  color: var(--phos); font-size: 1.32rem; letter-spacing: 0.06em;
  text-transform: uppercase; margin: 2.6em 0 0.7em;
  text-shadow: 0 0 12px rgba(207, 226, 255, 0.35);
}
.feed h2::before { content: "◇ "; color: var(--phos-dim); }
.feed em { font-style: normal; color: var(--phos); }
.feed strong { color: var(--phos); font-weight: 400; }
.feed .dinkus {
  text-align: center; color: var(--phos-dim); letter-spacing: 1.2em;
  margin: 2em 0;
}
/* factbox → TRACK DATA */
.feed .factbox {
  border: 1px solid var(--phos-dim); margin: 2em 0; font-size: 0.88rem;
  background: rgba(10, 20, 36, 0.8);
}
.feed .factbox-title {
  margin: 0; padding: 0.45rem 0.9rem; background: var(--phos-dim);
  color: var(--tube); font-size: 0.82rem; font-weight: 400;
  letter-spacing: 0.22em; text-transform: uppercase;
}
.feed .factbox-title::before { content: "TRACK DATA // "; }
.feed .factbox dl { margin: 0; padding: 0.5rem 0.9rem 0.7rem; }
.feed .factbox .row {
  display: flex; justify-content: space-between; gap: 1.5rem;
  padding: 0.42rem 0; border-bottom: 1px dashed var(--phos-ghost);
}
.feed .factbox .row:last-child { border-bottom: 0; }
.feed .factbox dt { color: var(--phos-dim); text-transform: uppercase; font-size: 0.76rem; letter-spacing: 0.1em; padding-top: 0.15em; }
.feed .factbox dd { margin: 0; text-align: right; color: var(--phos); }
/* pullquote → VOICE NET */
.feed .pullquote {
  border: 1px dashed var(--alert); border-left: 4px solid var(--alert);
  padding: 1rem 1.2rem; margin: 2em 0; position: relative;
}
.feed .pullquote::before {
  content: "VOICE NET // BRIDGE-TO-BRIDGE"; display: block;
  color: var(--alert); font-size: 0.72rem; letter-spacing: 0.26em;
  margin-bottom: 0.6rem;
}
.feed .pullquote p {
  margin: 0; color: var(--phos); font-size: 1.08rem; line-height: 1.55;
  text-transform: uppercase;
}
.feed .pullquote cite {
  display: block; margin-top: 0.7rem; font-style: normal;
  color: var(--phos-dim); font-size: 0.78rem; letter-spacing: 0.14em;
  text-transform: uppercase;
}
.feed .pullquote cite::before { content: "SOURCE: "; }

/* --- deck log (timeline) ----------------------------------- */
.eventlog { max-width: var(--measure); margin: 3rem auto 0; }
.log-head {
  font-family: "Chakra Petch", sans-serif; font-weight: 600; font-size: 1.32rem;
  color: var(--phos); text-transform: uppercase; margin: 0 0 0.4rem;
  letter-spacing: 0.06em;
  text-shadow: 0 0 12px rgba(207, 226, 255, 0.35);
}
.log-head::before { content: "◇ "; color: var(--phos-dim); }
.log-sub { color: var(--phos-dim); font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; margin: 0 0 1.4rem; }
.eventlog ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--phos-ghost); }
.eventlog li {
  display: grid; grid-template-columns: 10.5rem 1fr; gap: 0.2rem 1.4rem;
  padding: 0.95rem 0.6rem; border-bottom: 1px solid var(--phos-ghost);
  font-size: 0.92rem;
}
.eventlog li.key { background: rgba(207, 226, 255, 0.06); border-left: 3px solid var(--alert); }
.eventlog .d { color: var(--alert); letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.8rem; padding-top: 0.2em; }
.eventlog h3 { grid-column: 2; margin: 0; font-size: 0.95rem; font-weight: 400; color: var(--phos); text-transform: uppercase; letter-spacing: 0.06em; }
.eventlog .d + h3 { grid-column: auto; }
.eventlog p { grid-column: 2; margin: 0.25rem 0 0; color: var(--phos-soft); }
@media (max-width: 40rem) {
  .eventlog li { grid-template-columns: 1fr; }
  .eventlog h3, .eventlog p { grid-column: 1; }
}

/* --- references + exit ------------------------------------- */
.refs { max-width: var(--measure); margin: 3rem auto 0; font-size: 0.85rem; }
.refs h2 {
  font-family: "Chakra Petch", sans-serif; font-weight: 600; font-size: 1.1rem;
  color: var(--phos); text-transform: uppercase; margin: 0 0 0.8rem;
  letter-spacing: 0.06em;
}
.refs h2::before { content: "◇ "; color: var(--phos-dim); }
.refs ol { margin: 0; padding-left: 1.6rem; color: var(--phos-dim); }
.refs li { margin-bottom: 0.4rem; }
.refs em { font-style: normal; color: var(--phos-soft); }
.exit {
  max-width: var(--measure); margin: 3.5rem auto 0; padding-block: 2rem 3.5rem;
  border-top: 1px solid var(--phos-ghost);
  font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase;
}
.exit p { margin: 0 0 1.2rem; color: var(--phos-dim); }
.exit .prompt::after { content: "█"; animation: blink 1.1s steps(1) infinite; color: var(--phos); }
@keyframes blink { 50% { opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .exit .prompt::after { animation: none; } }
.exit ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.7rem 2rem; }
.exit a { color: var(--phos); }
.exit a:hover { background: var(--phos); color: var(--tube); }
</style>
</head>
<body class="crt">

<div class="statusbar">
  <div class="wrap">
    <span><b>{{ site.name }}</b> // THEME THUNDER № 12</span>
    <span>MODE: <b>LIVE PLOT</b> · WATCH 0400–0800 · 24 JUL 87</span>
    <span><a href="{{ art.url }}">STANDARD EDITION →</a></span>
  </div>
</div>

<header class="console-head wrap">
  <p class="boot">CIC // DDG 993 // CONDITION III ······ LINK 11 <b>UP</b> · EMCON <b>ALPHA</b> · MINE WATCH <b>SET</b></p>
  <h1 class="trackname">First<br>Convoy</h1>
  <p class="dek-block">{{ art.data.dek }}</p>
  <p class="opline">
    <span>FILE: <b>{{ art.data.fileNo }}</b></span>
    <span>DESK: <b>LAND &amp; SEA</b></span>
    <span>POSTED: <b>{{ art.date | readableDate }}</b></span>
    <span>SOURCES: <b>OPEN // UNCLASSIFIED</b></span>
  </p>
</header>

<div class="plotbay wrap">
  <div class="plot">
    <div class="chart" role="img" aria-label="Stylised combat-information-center plot of the first Earnest Will convoy: friendly circles in column along the shipping channel, a mine datum marked ahead of the tanker Bridgeton, and an unidentified high-speed contact closing from Farsi Island.">
      <svg viewBox="0 0 520 460" aria-hidden="true">
        <circle class="ring" cx="250" cy="245" r="70" />
        <circle class="ring" cx="250" cy="245" r="140" />
        <circle class="ring" cx="250" cy="245" r="205" />
        <path class="coast" d="M 20,86 L 60,74 96,84 130,70 168,80 205,64 245,76 285,60 330,72 372,58 415,70 458,56 500,66" />
        <path class="coast" d="M 16,428 L 52,414 84,422 118,406 148,416" />
        <path class="isle" d="M 396,146 L 412,140 424,148 420,162 404,166 394,158 Z" />
        <path class="lane" d="M 96,404 L 420,96" />
        <path class="lane" d="M 140,436 L 464,128" />
        <g class="refresh">
          <circle class="frnd" cx="250" cy="245" r="7" /><circle class="frnd-dot" cx="250" cy="245" r="1.6" />
          <line class="ldr" x1="255" y1="240" x2="271" y2="224" />
          <circle class="frnd" cx="300" cy="196" r="9" /><circle class="frnd-dot" cx="300" cy="196" r="1.6" />
          <line class="ldr" x1="306" y1="190" x2="322" y2="174" />
          <circle class="frnd" cx="342" cy="157" r="7" /><circle class="frnd-dot" cx="342" cy="157" r="1.6" />
          <line class="ldr" x1="347" y1="152" x2="362" y2="137" />
          <circle class="frnd" cx="203" cy="291" r="7" /><circle class="frnd-dot" cx="203" cy="291" r="1.6" />
          <line class="ldr" x1="208" y1="286" x2="224" y2="270" />
          <circle class="frnd" cx="158" cy="334" r="7" /><circle class="frnd-dot" cx="158" cy="334" r="1.6" />
          <line class="ldr" x1="163" y1="329" x2="179" y2="313" />
          <rect class="unkn" x="452" y="188" width="12" height="12" />
          <rect class="host" x="404" y="206" width="12" height="12" transform="rotate(45 410 212)" />
          <line class="host-ldr" x1="404" y1="218" x2="376" y2="238" />
          <path class="datum" d="M 322,150 L 338,166 M 338,150 L 322,166" />
          <circle class="datum-ring" cx="330" cy="158" r="26" />
        </g>
        <text class="lbl lbl--trk" x="216" y="262">7001 KIDD</text>
        <text class="lbl lbl--trk" x="252" y="192">7012 GAS PRINCE</text>
        <text class="lbl lbl--trk" x="300" y="132">7011 BRIDGETON</text>
        <text class="lbl lbl--trk" x="126" y="288">7002 FOX</text>
        <text class="lbl lbl--trk" x="84" y="352">7003 CROMMELIN</text>
        <text class="lbl lbl--hot" x="346" y="122">DATUM 0658C</text>
        <text class="lbl lbl--hot" x="388" y="238">0447 HSC</text>
        <text class="lbl" x="446" y="182">0433 DHOW</text>
        <text class="lbl" x="398" y="134">FARSI I.</text>
        <text class="lbl" x="24" y="52">IRANIAN COAST</text>
        <text class="lbl" x="20" y="448">SAUDI COAST</text>
      </svg>
    </div>
    <div class="rack" aria-label="Watch readouts">
      <div class="stat stat--alert">MINE DATUM<b>BRG 322 · 2,400 YDS</b></div>
      <div class="stat">CONVOY<b>EW 87-01 · SPD 16 KT</b></div>
      <div class="stat">GUIDE<b>TN 7011 — HAS THE LEAD</b></div>
      <div class="stat">WEAPONS<b>HOLD // TIGHT</b></div>
      <div class="stat stat--calm">SWEEP ASSETS<b>NONE IN THEATRE</b></div>
    </div>
  </div>
  <p class="plot-caption">NTDS-STYLE PLOT · CENTRAL GULF · 0658C, 24 JUL 1987 · THE TANKER LEADS HER ESCORTS</p>
</div>

<article class="feed wrap" aria-label="Article, combat-information-center edition">
{{ art.templateContent | safe }}
</article>

{%- if art.data.timeline %}
<section class="eventlog wrap" aria-label="Deck log">
  <h2 class="log-head">Deck Log</h2>
  <p class="log-sub">{{ art.data.timeline.title }}</p>
  <ol>
    {%- for item in art.data.timeline.items %}
    <li{% if item.key %} class="key"{% endif %}>
      <span class="d">{{ item.date }}</span>
      <h3>{{ item.title }}</h3>
      <p>{{ item.text }}</p>
    </li>
    {%- endfor %}
  </ol>
</section>
{%- endif %}

{%- if art.data.sources %}
<section class="refs wrap" aria-label="Sources">
  <h2>Reference Index</h2>
  <ol>
    {%- for s in art.data.sources %}
    <li>{{ s | safe }}</li>
    {%- endfor %}
  </ol>
</section>
{%- endif %}

<footer class="exit wrap">
  <p class="prompt">END OF WATCH. PLOT STEADY. BRIDGETON MAKES WAY </p>
  <ul>
    <li><a href="{{ art.url }}">[ STANDARD EDITION ]</a></li>
    <li><a href="/thunder/earnest-will-1987-flash/">[ RADIO CENTRAL EDITION ]</a></li>
    <li><a href="/thunder/">[ THEME THUNDER INDEX ]</a></li>
    <li><a href="/">[ {{ site.name }} FRONT PAGE ]</a></li>
  </ul>
</footer>

</body>
</html>
