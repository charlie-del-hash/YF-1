<!-- Display faces below are subset via text= to the glyphs the cards use
     (A-Z a-z 0-9 and basic punctuation) — cuts font payload roughly in half.
     If a future card name needs an unusual character, add it to text= or
     drop the param entirely. Body text uses IBM Plex Mono (full, above). -->
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Arimo:ital,wght@1,700&family=Bebas+Neue&family=Chakra+Petch:wght@600&family=Doto:wght@900&family=Handjet:wght@800&family=Michroma&family=Old+Standard+TT:ital@1&family=Silkscreen:wght@700&family=Stardos+Stencil:wght@700&family=UnifrakturCook:wght@700&family=UnifrakturMaguntia&family=VT323&text=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789%20.%2C%27%E2%80%99%E2%80%94%E2%80%93-!%3F()%2F%26%E2%84%96%C2%B7&display=swap" rel="stylesheet">
<style>
/* ============================================================
   THEME THUNDER — channel select
   Twelve dispatches, nine decades of print and phosphor. Each
   card borrows the type and palette of the edition behind it.
   ============================================================ */
:root {
  --void:  #0f0f13;
  --void-2:#17171d;
  --bone:  #e9e6da;
  --dim:   #8b8b96;
  --bolt:  #f5c518;
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--void); color: var(--bone);
  font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace;
  line-height: 1.6; font-size: 1rem;
}
a { color: inherit; text-decoration: none; }
::selection { background: var(--bolt); color: var(--void); }
.wrap { max-width: 72rem; margin-inline: auto; padding-inline: 1.4rem; }

/* --- header ------------------------------------------------ */
.topline {
  display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.3rem 1.6rem;
  padding: 0.8rem 0; font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--dim); border-bottom: 1px solid #26262e;
}
.topline a:hover { color: var(--bolt); }
.hero { padding: 4.2rem 0 3.2rem; }
.hero .bolt { color: var(--bolt); }
.hero h1 {
  font-family: "Anton", sans-serif; font-weight: 400; text-transform: uppercase;
  font-size: clamp(3rem, 10vw, 6.8rem); line-height: 0.92; margin: 0 0 1.4rem;
  letter-spacing: 0.01em;
}
.hero h1 .flash { color: var(--bolt); }
.hero .sub { max-width: 44rem; color: var(--bone); font-size: 1.02rem; margin: 0 0 0.6rem; }
.hero .subsub { color: var(--dim); font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; margin: 0; }

/* --- channel grid ------------------------------------------ */
.channels {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
  gap: 1.4rem; padding-bottom: 4rem;
}
.ch {
  position: relative; display: flex; flex-direction: column; min-height: 21rem;
  border: 1px solid #2c2c35; overflow: hidden;
  transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
}
.ch:hover, .ch:focus-visible {
  transform: translateY(-4px);
  border-color: var(--bolt);
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.55);
}
.ch-top {
  display: flex; justify-content: space-between; align-items: baseline;
  gap: 1rem; margin-bottom: auto;
}
.ch-no { font-size: 0.7rem; letter-spacing: 0.2em; opacity: 0.75; white-space: nowrap; }
.ch-era { font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase; opacity: 0.9; }
.ch-body { display: flex; flex-direction: column; flex: 1; padding: 1.1rem 1.2rem 1.15rem; }
.ch-name { margin: 1.6rem 0 0.55rem; line-height: 1; }
.ch-title { font-size: 0.86rem; line-height: 1.5; margin: 0 0 1.2rem; opacity: 0.92; }
.ch-cta { margin-top: auto; font-size: 0.75rem; letter-spacing: 0.24em; text-transform: uppercase; }
.ch-cta::after { content: " →"; }

/* № 1 — scope 1982 */
.ch--scope { background: radial-gradient(ellipse at 50% 0%, #0a2413 0%, #041008 70%); color: #b9f5cc; }
.ch--scope::before {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: repeating-linear-gradient(0deg, rgba(0,0,0,0.28) 0 1px, transparent 1px 3px);
}
.ch--scope .ch-top { color: #46915f; }
.ch--scope .ch-name { font-family: "VT323", monospace; font-size: 3rem; color: #3aff77; text-shadow: 0 0 12px rgba(58,255,119,0.5); }
.ch--scope .ch-cta { color: #ffb000; }
/* № 2 — natops 1974 */
.ch--natops { background: #f0ece0; color: #1c1c1a; }
.ch--natops .ch-body { border: 2px solid #1c1c1a; margin: 0.55rem; }
.ch--natops .ch-name { font-family: "Stardos Stencil", monospace; font-weight: 700; font-size: 2.1rem; text-transform: uppercase; }
.ch--natops .ch-top { color: #56564e; }
.ch--natops .ch-cta { color: #a8271b; }
/* № 3 — production front */
.ch--prod { background: #f3ead3; color: #23241f; }
.ch--prod .ch-body { border-top: 8px solid #b02e26; }
.ch--prod .ch-name { font-family: "Anton", sans-serif; font-size: 2.3rem; text-transform: uppercase; color: #b02e26; }
.ch--prod .ch-top { color: #1e3a56; }
.ch--prod .ch-cta {
  background: #1e3a56; color: #f3ead3;
  margin: auto -1.2rem -1.15rem; padding: 0.85rem 1.2rem;
}
/* № 4 — feldheer 1918 */
.ch--feld { background: radial-gradient(ellipse 120% 110% at 50% 30%, #e7d9b8 55%, #cdb88b 100%); color: #2e2717; }
.ch--feld .ch-name { font-family: "UnifrakturMaguntia", serif; font-size: 2.5rem; }
.ch--feld .ch-top { color: #6d5f43; }
.ch--feld .ch-cta { color: #9c2b1e; }
/* № 5 — agitprop 1949 */
.ch--agit { background: #efe3cb; color: #211d18; }
.ch--agit .ch-top {
  background: #c02418; color: #efe3cb;
  margin: -1.1rem -1.2rem 0; padding: 0.85rem 1.2rem 0.7rem;
}
.ch--agit .ch-name {
  font-family: "Bebas Neue", sans-serif; font-size: 3rem; text-transform: uppercase;
  color: #c02418; text-shadow: 0.14rem 0.14rem 0 #211d18;
}
.ch--agit .ch-cta { color: #99190f; }
/* № 6 — broadsheet 1915 */
.ch--sheet { background: #f1e6cd; color: #241f16; }
.ch--sheet .ch-body { border-block: 3px double #241f16; margin: 0.8rem 0.9rem; }
.ch--sheet .ch-name { font-family: "UnifrakturCook", serif; font-weight: 700; font-size: 2.2rem; }
.ch--sheet .ch-title { font-family: "Old Standard TT", serif; font-style: italic; font-size: 0.95rem; }
.ch--sheet .ch-top { color: #57492f; }
.ch--sheet .ch-cta { color: #241f16; }
/* № 7 — waterfall 1968 */
.ch--fall { background: radial-gradient(ellipse at 50% 0%, #082031 0%, #030c14 70%); color: #bfe9f7; }
.ch--fall::before {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background:
    linear-gradient(90deg, transparent 0 24%, rgba(79,227,255,0.5) 24% calc(24% + 2px), transparent calc(24% + 2px) 58%, rgba(79,227,255,0.32) 58% calc(58% + 2px), transparent calc(58% + 2px) 86%, rgba(79,227,255,0.2) 86% calc(86% + 2px), transparent calc(86% + 2px)),
    repeating-linear-gradient(0deg, rgba(0,0,0,0.28) 0 1px, transparent 1px 3px);
}
.ch--fall .ch-top { color: #3b7e97; }
.ch--fall .ch-name { font-family: "Doto", monospace; font-weight: 900; font-size: 2.5rem; color: #4fe3ff; text-shadow: 0 0 12px rgba(79,227,255,0.5); }
.ch--fall .ch-cta { color: #ff6d4d; }
/* № 8 — big board 1983 */
.ch--board { background: radial-gradient(circle at 50% 30%, #1a1408 0%, #0b0b0e 75%); color: #f6dfae; }
.ch--board::before {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(circle at 50% 42%, transparent 0 34%, rgba(255,176,0,0.22) 34% calc(34% + 1px), transparent calc(34% + 1px) 52%, rgba(255,176,0,0.16) 52% calc(52% + 1px), transparent calc(52% + 1px)),
    repeating-linear-gradient(0deg, rgba(0,0,0,0.25) 0 1px, transparent 1px 3px);
}
.ch--board .ch-top { color: #9a742f; }
.ch--board .ch-name { font-family: "Michroma", sans-serif; font-size: 1.55rem; line-height: 1.15; color: #ffb000; text-shadow: 0 0 12px rgba(255,176,0,0.5); }
.ch--board .ch-cta { color: #ff4136; }
/* № 9 — tape 1991 */
.ch--tape { background: linear-gradient(180deg, #091008 0%, #0d140c 55%, #162013 100%); color: #c6dcc0; }
.ch--tape::before {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background:
    linear-gradient(0deg, rgba(255,255,255,0.14) 0 5px, transparent 5px),
    repeating-linear-gradient(0deg, rgba(0,0,0,0.3) 0 1px, transparent 1px 3px);
}
.ch--tape .ch-top { color: #5f7a58; }
.ch--tape .ch-name { font-family: "Silkscreen", monospace; font-weight: 700; font-size: 1.7rem; color: #cfeec6; text-shadow: 0 0 12px rgba(207,238,198,0.45); }
.ch--tape .ch-cta { color: #f2f2ee; }
/* № 10 — slides 2003 */
.ch--deck { background: #9aa1ae; color: #1a1a1a; }
.ch--deck .ch-body {
  background: #fff; border: 1px solid #6f7683; margin: 0.7rem;
  box-shadow: 2px 2px 0 rgba(90,96,107,0.55);
}
.ch--deck .ch-top {
  background: #006b3c; color: #fff; margin: -1.1rem -1.2rem 0;
  padding: 0.5rem 1.2rem 0.4rem;
}
.ch--deck .ch-name {
  font-family: Arial, "Arimo", sans-serif; font-weight: 700; font-style: italic;
  font-size: 2rem; color: #1f3f94;
  border-bottom: 0.28rem solid; border-image: linear-gradient(90deg, #1f3f94, transparent 85%) 1;
  padding-bottom: 0.3rem;
}
.ch--deck .ch-title { font-family: Arial, "Arimo", sans-serif; }
.ch--deck .ch-cta { color: #1414cc; text-decoration: underline; }
/* № 11 — flash 1987 */
.ch--flash { background: radial-gradient(ellipse at 50% 0%, #241004 0%, #0c0502 70%); color: #f0c39b; }
.ch--flash::before {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background:
    repeating-linear-gradient(0deg, rgba(0,0,0,0.26) 0 1px, transparent 1px 3px),
    repeating-linear-gradient(90deg, rgba(0,0,0,0.18) 0 1px, transparent 1px 3px);
}
.ch--flash .ch-top { color: #9c6a3d; }
.ch--flash .ch-name {
  font-family: "Handjet", monospace; font-weight: 800; font-size: 2.7rem;
  color: #ffa64d; text-shadow: 0 0 14px rgba(255,166,77,0.55);
  text-transform: uppercase; letter-spacing: 0.04em;
}
.ch--flash .ch-name::after {
  content: ""; display: inline-block; width: 0.5em; height: 0.85em;
  background: currentColor; margin-left: 0.18em;
  animation: chblink 1.1s steps(1) infinite;
}
@keyframes chblink { 50% { opacity: 0; } }
.ch--flash .ch-cta { color: #ff4530; }
/* № 12 — cic 1987 */
.ch--cic { background: radial-gradient(circle at 50% 30%, #0b1830 0%, #04070e 75%); color: #b9cdec; }
.ch--cic::before {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(circle at 50% 42%, transparent 0 30%, rgba(207,226,255,0.2) 30% calc(30% + 1px), transparent calc(30% + 1px) 48%, rgba(207,226,255,0.14) 48% calc(48% + 1px), transparent calc(48% + 1px)),
    repeating-linear-gradient(0deg, rgba(0,0,0,0.25) 0 1px, transparent 1px 3px);
}
.ch--cic .ch-top { color: #56719f; }
.ch--cic .ch-name {
  font-family: "Chakra Petch", sans-serif; font-weight: 600; font-size: 1.9rem;
  color: #cfe2ff; text-shadow: 0 0 12px rgba(207,226,255,0.5); text-transform: uppercase;
}
.ch--cic .ch-cta { color: #ffcf5c; }

/* --- footer ------------------------------------------------ */
.foot {
  border-top: 1px solid #26262e; padding: 1.6rem 0 3rem;
  color: var(--dim); font-size: 0.82rem; letter-spacing: 0.08em;
}
.foot a { color: var(--bone); }
.foot a:hover { color: var(--bolt); }
@media (prefers-reduced-motion: reduce) { .ch { transition: none; } .ch--flash .ch-name::after { animation: none; } }
</style>
</head>
<body>

<div class="wrap">
  <div class="topline">
    <span>{{ site.name }} // special channel</span>
    <a href="/">← Back to the front page</a>
  </div>

  <header class="hero">
    <h1>Theme <span class="flash">⚡</span> Thunder</h1>
    <p class="sub">Twelve dispatches from the journal, re-set in the print — and phosphor — of their day: a London broadsheet, a field manual, a production poster, an agitprop sheet, a sonar waterfall, a flight manual, a radar scope, a missile-warning board, a flash message, a CIC plot, a gun-camera tape, a slide deck. Same words. Period type.</p>
    <p class="subsub">Every edition links back to its standard version — pick your channel.</p>
  </header>

  <nav class="channels" aria-label="Theme Thunder editions">

    <a class="ch ch--sheet" href="/thunder/shell-scandal-1915/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">London · Friday morning</span><span class="ch-no">№ 6 · 1915</span></span>
        <span class="ch-name">The Daily Sitrep.</span>
        <span class="ch-title">The shell scandal of 1915 — the shortage that toppled a government, at a penny a copy.</span>
        <span class="ch-cta">Read the front page</span>
      </span>
    </a>

    <a class="ch ch--feld" href="/thunder/storm-troops-1918/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">Großes Hauptquartier</span><span class="ch-no">№ 4 · 1918</span></span>
        <span class="ch-name">Der Angriff</span>
        <span class="ch-title">Storm troops, 1918 — the reinvention of the infantry attack, as a field-printed assault manual.</span>
        <span class="ch-cta">Open the manual</span>
      </span>
    </a>

    <a class="ch ch--prod" href="/thunder/shell-game-155mm/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">War production bulletin</span><span class="ch-no">№ 3 · 1943</span></span>
        <span class="ch-name">More Shells!</span>
        <span class="ch-title">The 155 mm shell game — the West relearns that ammunition is an industry, in poster type.</span>
        <span class="ch-cta">See the bulletin</span>
      </span>
    </a>

    <a class="ch ch--agit" href="/thunder/kalashnikov-century/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">Госиздат · agitprop</span><span class="ch-no">№ 5 · 1949</span></span>
        <span class="ch-name">AK — 100 000 000</span>
        <span class="ch-title">The Kalashnikov century — one rifle arms half the world, told as a constructivist poster.</span>
        <span class="ch-cta">Unroll the poster</span>
      </span>
    </a>

    <a class="ch ch--fall" href="/thunder/four-submarines-1968/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">NAVFAC sound room</span><span class="ch-no">№ 7 · 1968</span></span>
        <span class="ch-name">Waterfall '68</span>
        <span class="ch-title">Four submarines lost in one spring — read off a sonar lofargram that never stops falling.</span>
        <span class="ch-cta">Roll the paper</span>
      </span>
    </a>

    <a class="ch ch--natops" href="/thunder/f14-tomcat-dossier/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">Navair · flight manual</span><span class="ch-no">№ 2 · 1974</span></span>
        <span class="ch-name">NATOPS F-14A</span>
        <span class="ch-title">The Tomcat dossier — typewriter text, warning boxes, punch holes and a record of changes.</span>
        <span class="ch-cta">File the manual</span>
      </span>
    </a>

    <a class="ch ch--scope" href="/thunder/bekaa-valley-1982/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">GCI station · replay mode</span><span class="ch-no">№ 1 · 1982</span></span>
        <span class="ch-name">SCOPE 1982</span>
        <span class="ch-title">The Bekaa Valley air battles — replayed in green phosphor on a ground-controlled-intercept console.</span>
        <span class="ch-cta">Light the tube</span>
      </span>
    </a>

    <a class="ch ch--board" href="/thunder/false-alarms-1983/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">Warning center · graveyard watch</span><span class="ch-no">№ 8 · 1983</span></span>
        <span class="ch-name">Big Board 83</span>
        <span class="ch-title">The false alarms of 1983 — five phantom missiles marching across an amber wall map.</span>
        <span class="ch-cta">Light the board</span>
      </span>
    </a>

    <a class="ch ch--flash" href="/thunder/earnest-will-1987-flash/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">Radio central · fleet broadcast</span><span class="ch-no">№ 11 · 1987</span></span>
        <span class="ch-name">FLASH 87</span>
        <span class="ch-title">Earnest Will's first convoy as flash traffic, typing itself onto a gas-plasma message screen.</span>
        <span class="ch-cta">Copy the traffic</span>
      </span>
    </a>

    <a class="ch ch--cic" href="/thunder/earnest-will-1987-cic/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">Combat information center</span><span class="ch-no">№ 12 · 1987</span></span>
        <span class="ch-name">CIC 1987</span>
        <span class="ch-title">The same convoy from the darkened plot room — NTDS symbols, a mine datum dead ahead.</span>
        <span class="ch-cta">Man the plot</span>
      </span>
    </a>

    <a class="ch ch--tape" href="/thunder/first-night-1991/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">Wing intel vault · VHS</span><span class="ch-no">№ 9 · 1991</span></span>
        <span class="ch-name">Tape 1991</span>
        <span class="ch-title">The first night over Baghdad — played back from a gun-camera cassette at H-hour minus thirteen.</span>
        <span class="ch-cta">Press play</span>
      </span>
    </a>

    <a class="ch ch--deck" href="/thunder/iraq-2003-briefing/">
      <span class="ch-body">
        <span class="ch-top"><span class="ch-era">Commander's update · read-only</span><span class="ch-no">№ 10 · 2003</span></span>
        <span class="ch-name">Slides 2003</span>
        <span class="ch-title">The war on bullet points — sat through as a period slide deck, UNCLASSIFIED bars and all.</span>
        <span class="ch-cta">Begin slide show</span>
      </span>
    </a>

  </nav>

  <footer class="foot">
    <p>Theme Thunder is {{ site.name }}'s period-print channel: the same article, unaltered, re-set in a design native to its subject's era. · <a href="/">Front page</a> · <a href="/articles/">All dispatches</a></p>
  </footer>
