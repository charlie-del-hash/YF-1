# Supabase — project must be created in the EU (Frankfurt) region. 05-RGPD §1.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# Settings -> API. Newer projects issue "sb_publishable_..."; older ones a JWT
# named anon. Either variable name works; both are safe in a browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
#NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
# Server-only. Never prefix with NEXT_PUBLIC_. CLAUDE.md rule 5.
SUPABASE_SERVICE_ROLE_KEY=""

# Map tiles. The OSMF public tile servers forbid app use and will block you
# without notice, so a key is required in production. MapTiler, Stadia, Jawg
# and Protomaps all serve MapLibre-compatible OSM styles from the EU.
NEXT_PUBLIC_MAP_STYLE_URL=""

# Site URL used in magic-link redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Feature flags — off unless explicitly turned on. CLAUDE.md.
NEXT_PUBLIC_FEATURE_PHONE_AUTH="false"
